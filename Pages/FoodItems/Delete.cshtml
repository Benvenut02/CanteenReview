@page "{id:int}"
@model CanteenReview.Pages.FoodItems.DeleteModel
@{
    ViewData["Title"] = "Delete Food Item";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-6 col-md-8">
        <div class="custom-card border-danger border-opacity-25 text-center p-4">
            <div class="display-5 text-danger mb-3"><i class="bi bi-exclamation-triangle"></i></div>
            <h3 class="fw-bold text-danger mb-2">Delete Food Item?</h3>
            <p class="text-muted mb-4 small">Are you sure you want to remove <strong>@Model.FoodItem.Name</strong> from the canteen menu? This will permanently delete all associated student reviews (@(Model.FoodItem.Reviews?.Count ?? 0) reviews).</p>

            <div class="bg-light p-3 rounded-3 mb-4 text-start border">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Item Name:</span>
                    <span class="fw-bold">@Model.FoodItem.Name</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Category:</span>
                    <span class="fw-medium">@Model.FoodItem.Category</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Price:</span>
                    <span class="fw-bold text-dark">₹@Model.FoodItem.Price.ToString("0.00")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Associated Reviews:</span>
                    <span class="badge bg-warning text-dark fw-bold">@(Model.FoodItem.Reviews?.Count ?? 0) Reviews</span>
                </div>
            </div>

            <form method="post">
                <input type="hidden" asp-for="FoodItem.Id" />
                <div class="d-flex gap-3 justify-content-center">
                    <a asp-page="/Index" class="btn btn-light-custom px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-danger px-4 rounded-3 fw-semibold">
                        <i class="bi bi-trash me-1"></i> Delete Item
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

