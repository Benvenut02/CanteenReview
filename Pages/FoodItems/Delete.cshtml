@page "{id:int}"
@model CanteenReview.Pages.FoodItems.DeleteModel
@{
    ViewData["Title"] = "Delete Food Item";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="custom-card border-danger border-opacity-25 text-center p-4">
            <div class="display-3 text-danger mb-3">⚠️</div>
            <h2 class="fw-bold text-danger mb-2">Delete Food Item?</h2>
            <p class="text-muted mb-4">Are you sure you want to remove <strong>@Model.FoodItem.Name</strong> from the canteen menu? This action cannot be undone and will delete all associated student reviews (@(Model.FoodItem.Reviews?.Count ?? 0) reviews).</p>

            <div class="bg-light p-3 rounded-3 mb-4 text-start">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Item Name:</span>
                    <span class="fw-bold">@Model.FoodItem.Name</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Category:</span>
                    <span>@Model.FoodItem.Category</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Price:</span>
                    <span class="fw-bold text-success">₹@Model.FoodItem.Price.ToString("0.00")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Associated Reviews:</span>
                    <span class="badge bg-warning text-dark">@(Model.FoodItem.Reviews?.Count ?? 0) Reviews</span>
                </div>
            </div>

            <form method="post">
                <input type="hidden" asp-for="FoodItem.Id" />
                <div class="d-flex gap-3 justify-content-center">
                    <a asp-page="/Index" class="btn btn-light border px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash-fill me-1"></i> Yes, Delete Item
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
